# Personal config — never publish. Ship usage-config.example.json as the template instead.
usage-config.json

# Python build artifacts (interpreter/machine-specific; embed absolute paths)
__pycache__/
*.pyc

# Node / TypeScript build artifacts
node_modules/
dist/

# Local review DB from codex-bridge (not part of this project)
reviews.db
reviews.db-shm
reviews.db-wal

# Owner's personal working notes at the repo root (T-024 class D). They carry the owner's real
# account name and were one `git add -A` away from becoming tracked; ignoring them is the
# disposition that neither destroys them nor publishes them. Deliberately named, not globbed —
# a glob would silently swallow future notes that should get their own decision.
git-activity-review-2026-07-01-to-2026-07-15.md
westworld-investigation-2026-07-15.md

# macOS
.DS_Store

# Golden-capture working directories. Siblings of tests/golden/goldens/ so the final install
# can be an os.rename on one filesystem; a process killed mid-capture can leave one behind.
tests/golden/.staging-*/
tests/golden/goldens.previous/

# Machine-local storybloq server registrations (PID-named runtime state)
.story/servers/
